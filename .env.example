# Deployment / future backend configuration. Do not put secrets in browser JavaScript.
# For the static dashboard, public provider endpoints are configurable through
# window.AEROSENSE_CONFIG before services.js is loaded.
OPEN_METEO_AIR_BASE_URL=https://air-quality-api.open-meteo.com/v1/air-quality
OPEN_METEO_WEATHER_BASE_URL=https://api.open-meteo.com/v1/forecast
# Optional future OpenAQ server-side integration; keep API keys on the server.
OPENAQ_API_KEY=
OPENAQ_BASE_URL=https://api.openaq.org/v3
AEROSENSE_API_BASE_URL=http://localhost:8001/api
DATABASE_URL=
OSM_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
